{
  "id": "sales",
  "name": "Sales & POS",
  "version": "2.16.57",
  "description": "Point of sale: complete and void sales, and review sales history and metrics.",
  "agent": {
    "description": "Manages sales and point-of-sale operations: list and inspect sales, complete new sales transactions, void sales, configure payment methods, and retrieve sales statistics.",
    "keywords": [
      "sale",
      "pos",
      "payment",
      "transaction",
      "receipt",
      "void",
      "revenue",
      "checkout"
    ]
  },
  "depends_on": [
    "taxes"
  ],
