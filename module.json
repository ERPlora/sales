  "queries": {
    "sales.list": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/list.sql",
      "list": {
        "search": [
          "sale_number",
          "customer_name"
        ],
        "sort": [
          "id",
          "sale_number",
          "status",
          "total",
          "tax_amount",
          "payment_method_name",
          "customer_name",
          "channel",
          "staff_id",
          "created_at",
          "sale_seq"
        ],
        "default_sort": "created_at",
        "default_dir": "desc",
        "filters": {
          "sale_number": {
            "op": "like"
          },
          "status": {
            "op": "eq"
          },
          "total": {
            "op": "range"
          },
          "tax_amount": {
            "op": "range"
          },
          "payment_method_name": {
            "op": "eq"
          },
          "customer_name": {
            "op": "like"
          },
          "channel": {
            "op": "eq"
          },
          "staff_id": {
            "op": "eq"
          },
          "erp_date": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists sales records registered in the system. The date-range filter is `erp_date` (the local day, ISO YYYY-MM-DD, both ends inclusive), not the raw `created_at` timestamp: comparing the timestamp with a day cut the current day at 00:00 (sales#125)."
      }
    },
    "sales.get": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/get.sql",
      "ai": {
        "description": "Retrieves the full detail of a sale by its identifier"
      }
    },
    "sales.lines": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/lines.sql",
      "ai": {
        "description": "Lists the product lines (items) belonging to a sale"
      }
    },
    "sales.payments": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/payments.sql",
      "ai": {
        "description": "Lists the individual payments (tenders) that settled a sale — method, type, amount, tendered and change"
      }
    },
    "sales.orders.list": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/orders_list.sql",
      "ai": {
        "description": "Lists orders (ADR-0141). Serves both open tickets (status=open) and the cross-module read 'orders by customer/table' where satellite modules pass the order ids they own."
      }
    },
    "sales.order.get": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/order_get.sql",
      "ai": {
        "description": "Retrieves a single order (header) by its identifier (ADR-0141)"
      }
    },
    "sales.order.lines": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/order_lines.sql",
      "ai": {
        "description": "Lists the line items of an order (ADR-0141)"
      }
    },
    "sales.stats": {
      "permission": "sales.view_reports",
      "sql": "queries/stats.sql",
      "ai": {
        "description": "Sales KPIs for an optional inclusive date range (date_from/date_to, ISO days; empty = unbounded): count, total_revenue, avg_ticket, net_total, tax_total, discount_total of completed sales, plus voided_count (sales#27)."
      }
    },
    "sales.payment_methods": {
      "permission": "sales.view_paymentmethod",
      "expose_api": true,
      "sql": "queries/payment_methods.sql",
      "ai": {
        "description": "Lists the available payment methods"
      }
    },
    "sales.settings.get": {
      "permission": "sales.manage_settings",
      "sql": "queries/settings_get.sql",
      "ai": {
        "description": "Retrieves the point-of-sale configuration settings (payment methods allowed, default sell screen, default document format)"
      }
    },
    "sales.pos_settings.get": {
      "permission": "sales.view_sale",
      "sql": "queries/pos_settings_get.sql"
    },
    "sales.departments.list": {
      "permission": "sales.view_sale",
      "sql": "queries/departments_list.sql",
      "list": {
        "search": [
          "name"
        ],
        "sort": [
          "name",
          "sort_order"
        ],
        "default_sort": "sort_order",
        "default_dir": "asc",
        "filters": {
          "name": {
            "op": "like"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the departments the business offers on the till's open-price sheet, in the order they are shown, with the tax category each one charges at."
      }
    },
    "sales.quick_notes.list": {
      "permission": "sales.view_sale",
      "sql": "queries/quick_notes_list.sql",
      "list": {
        "search": [
          "text"
        ],
        "sort": [
          "text",
          "sort_order"
        ],
        "default_sort": "sort_order",
        "default_dir": "asc",
        "filters": {
          "text": {
            "op": "like"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the quick notes the business preconfigured for the line-note sheet of the till, in the order they are shown."
      }
    },
    "sales.business.get": {
      "permission": "sales.view_sale",
      "sql": "queries/business_get.sql",
      "ai": {
        "description": "Returns the hub's legal business name and tax id, as printed on the receipt header"
      }
    },
    "sales.today": {
      "permission": "sales.view_reports",
      "sql": "queries/today.sql",
      "ai": {
        "description": "Returns today's sales totals: amount sold and number of completed tickets"
      }
    },
    "sales.last_7_days": {
      "permission": "sales.view_reports",
      "sql": "queries/last_7_days.sql",
      "ai": {
        "description": "Returns the sales amount per day for the last 7 days (one row per day with sales)"
      }
    },
    "sales.by_idempotency_key": {
      "permission": "sales.view_sale",
      "sql": "queries/by_idempotency_key.sql",
      "ai": {
        "description": "Finds the sale recorded under a given idempotency key, if any. Used to make a retried checkout resolve to the very sale it already created instead of a second one."
      }
    },
    "sales.by_staff": {
      "permission": "sales.view_reports",
      "expose_api": true,
      "sql": "queries/by_staff.sql",
      "ai": {
        "description": "Breaks down completed sales attributed to each professional (staff_id) over a date range (date_from..date_to, inclusive): sales_count and gross/net/tax totals in cents. Backs the per-professional day close; combine with staff.commissions.summary to compute commission."
      }
    },
    "sales.refund_options": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/refund_options.sql",
      "ai": {
        "description": "For each tender that settled a sale, how much can still be refunded (`remaining`) and whether it can go back through its OWN method (`refundable` + `reason`: already_refunded or method_unavailable). Always returns one row per tender, so «no rows» never means «not refundable»."
      }
    },
    "sales.refunds": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/refunds.sql",
      "ai": {
        "description": "Lists the refund documents already issued against a sale, newest first."
      }
    },
    "sales.refund_by_idempotency_key": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/refund_by_idempotency_key.sql",
      "ai": {
        "description": "Finds the refund document already written for a given idempotency key, so a retry recovers the same document instead of refunding twice."
      }
    }
  },
  "records": {
    "sale": {
      "mutable": false,
      "reason": "fiscal",
      "correct_with": [
        "sales.void",
        "sales.refund"
      ]
    }
  },
  "commands": {
    "sales.complete_sale": {
      "permission": "sales.take_payment",
      "expose_api": true,
      "reads": [
        {
          "query": "taxes.rules.list",
          "required": true
        },
        {
          "query": "inventory.products.for_sale",
          "required": false
        },
        "sales.payment_methods",
        "sales.settings.get",
        {
          "query": "sales.by_idempotency_key",
          "params": {
            "idempotency_key": "payload.idempotency_key"
          }
        },
        {
          "query": "modifiers.options.all",
          "required": false
        },
        {
          "query": "combos.options.all",
          "required": false
        },
        {
          "query": "sales.order.lines",
          "params": {
            "order_id": "payload.order_id"
          },
          "required": false
        }
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "complete_sale"
      },
      "schema": "schemas/complete_sale.json",
      "ai": {
        "description": "Completes and records a sale with its line items and payment. Optional staff_id attributes the sale to the professional who performed it; optional appointment_id traces a sale created from an appointment (emits sales.sale.created_from_appointment)."
      }
    },
    "sales.checkout.preview": {
      "permission": "sales.view_sale",
      "reads": [
        {
          "query": "taxes.rules.list",
          "required": true
        },
        {
          "query": "inventory.products.for_sale",
          "required": false
        },
        "sales.settings.get",
        {
          "query": "modifiers.options.all",
          "required": false
        },
        {
          "query": "combos.options.all",
          "required": false
        },
        {
          "query": "sales.order.lines",
          "params": {
            "order_id": "payload.order_id"
          },
          "required": false
        }
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "preview_checkout"
      },
      "schema": "schemas/checkout_preview.json",
      "ai": {
        "description": "Values a ticket WITHOUT charging it and WITHOUT writing anything: same arithmetic as sales.complete_sale (same function), so the total, the taxable base, the quota and the per-line breakdown are the ones the sale would record. Answers total/subtotal/tax_total/discount_amount/gift_total in cents, tax_included as the hub has it, one row per resulting line (tax_category_key, tax_rate, unit_price, net_amount, tax_amount, line_total, combo_group_ref) and tax_breakdown by rate. Use it to show an authoritative total before charging, to split a mixed payment so the legs add up to the cent, and to preview how a goods combo splits across tax rates. It never creates a sale."
      }
    },
    "sales.order.open": {
      "permission": "sales.add_sale",
      "reads": [
        {
          "query": "inventory.products.for_sale",
          "required": false
        },
        {
          "query": "combos.options.all",
          "required": false
        },
        {
          "query": "modifiers.options.all",
          "required": false
        }
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "open_order"
      },
      "schema": "schemas/open_order.json",
      "ai": {
        "description": "Opens a new MUTABLE order (open ticket) with its line items materialized early (ADR-0141). The order is the canonical entity of the sale; on checkout it produces one or more immutable sales (split-bill). Amounts are provisional; the fiscal breakdown is frozen at checkout. Does not accept table_id (sales is table-agnostic; the table link is owned by the tables module)."
      }
    },
    "sales.order.fire": {
      "permission": "sales.add_sale",
      "reads": [
        {
          "query": "sales.order.lines",
          "params": {
            "order_id": "payload.order_id"
          }
        },
        {
          "query": "modifiers.options.all",
          "required": false
        }
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "fire_order"
      },
      "schema": "schemas/fire_order.json",
      "ai": {
        "description": "Fires the current lines of an open order to production (kitchen/bar) — ADR-0141. The kitchen ticket is born from the ORDER, not from the payment: waiters fire when they take the order, long before any sale exists. `label` is an opaque display string (e.g. \"Table 4\", \"Bar\", \"Pickup Ana\") that sales forwards without interpreting, because sales knows nothing about tables or customers. Each call is a new round."
      }
    },
    "sales.void": {
      "permission": "sales.void_sale",
      "reads": [
        {
          "query": "sales.get",
          "params": {
            "sale_id": "payload.sale_id"
          },
          "required": true
        },
        {
          "query": "sales.refunds",
          "params": {
            "sale_id": "payload.sale_id"
          },
          "required": true
        }
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "void_sale"
      },
      "schema": "schemas/void_sale.json",
      "ai": {
        "description": "Voids a COMPLETED sale with a mandatory reason (sales#26): the original stays immutable, voided_at/voided_by/void_reason are recorded, and sale.voided is emitted exactly once (a second call is refused with sales.already_voided). A sale that carries a full invoice cannot be voided: issue a credit note instead (sales.void_requires_credit_note). A sale that already has REFUNDS cannot be voided either (sales.sale_already_refunded, sales#247): money has already moved, so the operation that remains is refunding what is left with sales.refund."
      }
    },
    "sales.refund": {
      "permission": "sales.refund_sale",
      "reads": [
        {
          "query": "sales.get",
          "params": {
            "sale_id": "payload.sale_id"
          },
          "required": true
        },
        {
          "query": "sales.refund_options",
          "params": {
            "sale_id": "payload.sale_id"
          },
          "required": true
        },
        {
          "query": "sales.refund_by_idempotency_key",
          "params": {
            "idempotency_key": "payload.idempotency_key"
          }
        },
        "sales.payment_methods"
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "refund_sale"
      },
      "schema": "schemas/refund_sale.json",
      "emit": [
        "sale.refunded"
      ],
      "ai": {
        "description": "Refunds a COMPLETED sale by ELIGIBLE TENDER with an EDITABLE split (ADR-0386): the operator decides how much goes back to each leg of the original payment. A leg can never give back more than it was charged minus what it already returned, and going over is refused naming WHICH leg (sales.refund_exceeds_tender). A leg whose payment method is no longer available is marked not eligible with its reason instead of failing at confirm — the money still comes out through another destination the operator names. Unlike sales.void, an invoiced sale CAN be refunded: the credit note is issued by invoice. Idempotent by idempotency_key: the same key answers with the same refund document instead of paying twice."
      }
    },
