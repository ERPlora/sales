    "sales.order.add_line": {
      "permission": "sales.add_sale",
      "reads": [
        {
          "query": "sales.order.get",
          "params": {
            "order_id": "payload.order_id"
          },
          "required": true
        },
        {
          "query": "inventory.products.for_sale",
          "required": false
        },
        {
          "query": "combos.options.all",
          "required": false
        },
        {
          "query": "modifiers.options.all",
          "required": false
        }
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "add_order_line"
      },
      "ai": {
        "description": "Adds a line item to an open order and recomputes its provisional total (ADR-0141). The unit price is resolved SERVER-SIDE from the product catalogue (and, for a set menu, from the combo catalogue), and each supplement's delta from the modifier catalogue (sales#200): the check is charged at the price the line had when it was ordered (sales#175), so the price on the row decides money and the caller does not set it."
      }
    },
    "sales.order.add_open_line": {
      "permission": "sales.sell_open_price",
      "reads": [
        {
          "query": "sales.order.get",
          "params": {
            "order_id": "payload.order_id"
          },
          "required": true
        },
        {
          "query": "inventory.products.for_sale",
          "required": false
        },
        {
          "query": "combos.options.all",
          "required": false
        },
        {
          "query": "modifiers.options.all",
          "required": false
        }
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "add_order_line"
      },
      "ai": {
        "description": "Adds an OPEN-PRICE line (free amount, no catalogue product) to an open order and recomputes its provisional total. Same effect as sales.order.add_line but gated by sales.sell_open_price: nothing contradicts a typed amount, so the cashier needs the permission or a manager's PIN approval (ADR-0238)."
      }
    },
    "sales.order.update_line": {
      "permission": "sales.add_sale",
      "transaction": true,
      "sql": [
        "commands/order_update_line.sql",
        "commands/order_recompute_total.sql"
      ],
      "ai": {
        "description": "Updates the quantity of a line in an open order and recomputes its provisional total (ADR-0141)."
      }
    },
    "sales.order.set_line_staff": {
      "permission": "sales.add_sale",
      "sql": [
        "commands/order_set_line_staff.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "sales.order_line_not_available",
        "message": "That line is not open in this business."
      },
      "schema": "schemas/set_line_staff.json",
      "ai": {
        "description": "Corrects WHICH professional a line of an open order is charged to, without deleting the line (sales#277). The line is sealed at the moment it is added with whoever is on the till's chip (sales#273); this moves it afterwards. `staff_id` null means the line is attributed by the ticket's own professional, which is what the per-professional close falls back to. Money is untouched: who did the work does not change what it costs."
      }
    },
    "sales.order.split_line": {
      "permission": "sales.add_sale",
      "reads": [
        {
          "query": "sales.order.get",
          "params": {
            "order_id": "payload.order_id"
          },
          "required": true
        },
        {
          "query": "sales.order.lines",
          "params": {
            "order_id": "payload.order_id"
          },
          "required": true
        }
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "split_order_line"
      },
      "schema": "schemas/split_order_line.json",
      "ai": {
        "description": "Splits a line of N services of an open order into N lines of ONE unit each, keeping the check worth the same and recomputing its provisional total in the same transaction (sales#242 / ADR-0422). The line the payload names keeps its id and drops to one unit; the new ids come back in new_ids. It exists because the unit a voucher session buys is the LINE: services enforces one redemption per (checkout_ref, line_ref), so a line of «haircut x 2» would hand out two haircuts for one session. Refused with sales.line_not_splittable on a line already fired to production, a comp, a set menu, a fractional quantity, a line of one, or beyond the ceiling of units one split may write."
      }
    },
    "sales.order.remove_line": {
      "permission": "sales.add_sale",
      "transaction": true,
      "sql": [
        "commands/order_remove_line.sql",
        "commands/order_recompute_total.sql"
      ],
      "emit": [
        "sales.order.line_removed"
      ],
      "ai": {
        "description": "Removes (soft-deletes) a line from an open order and recomputes its provisional total (ADR-0141). It announces the removal with sales.order.line_removed so a module that had covered that line with a tender of its own can let it go at once."
      }
    },
    "sales.order.split": {
      "permission": "sales.add_sale",
      "transaction": true,
      "schema": "schemas/split_order.json",
      "sql": [
        "commands/order_split_create.sql",
        "commands/order_split_move_lines.sql",
        "commands/order_split_recompute_totals.sql"
      ],
      "ai": {
        "description": "Splits an open order in two (sales#61): the listed lines move to a NEW order, whose id comes back as new_ids[0]. Called when the floor opens a second check on a table (tables.sessions.split): tables owns the seating, sales owns the lines and the amounts. With no line_ids the second check opens blank. Nothing is prorated here — whole rows travel with their line_total, tax_category_key, round_no and fired_at intact, and BOTH totals are recomputed from their live lines, so the two halves add up to the original to the cent."
      }
    },
    "sales.order.merge": {
      "permission": "sales.add_sale",
      "transaction": true,
      "schema": "schemas/merge_orders.json",
      "sql": [
        "commands/order_merge_lines.sql",
        "commands/order_merge_void_source.sql",
        "commands/order_merge_recompute_totals.sql"
      ],
      "ai": {
        "description": "Joins two open orders into one (sales#61): every unpaid line of from_order_id moves to to_order_id and the source is voided. Called when two tables that BOTH ordered are merged (tables.sessions.merged) — tables cannot resolve that case because it does not know the lines. Lines are MOVED, not re-created, so what was already fired to the kitchen is not sent twice; both totals are recomputed from their live lines. Replaying it is a no-op."
      }
    },
    "sales.order.void": {
      "permission": "sales.void_sale",
      "transaction": true,
      "sql": [
        "commands/order_void.sql"
      ],
      "emit": [
        "sales.order.voided"
      ],
      "ai": {
        "description": "Voids an OPEN order (cancels the ticket before checkout); status open -> voided (ADR-0141). It announces the cancellation with sales.order.voided so a module that had covered any of its lines with a tender of its own can let the whole ticket go at once."
      }
    },
    "sales.order.set_discount": {
      "permission": "sales.add_sale",
      "transaction": true,
      "sql": [
        "commands/order_set_discount.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "sales.order_unavailable",
        "message": "That order is not open in this business."
      },
      "ai": {
        "description": "Sets the manual TICKET discount of an OPEN order: percent (0-100, sales#71) and/or a fixed amount in cents (discount_amount, sales#113). Applied by the server at checkout (sales.complete_sale discount_percent / discount_amount, prorated over the lines before the VAT — the amount by largest remainder, ADR-0210); allow_discounts is enforced there."
      }
    },
    "sales.order.set_label": {
      "permission": "sales.add_sale",
      "transaction": true,
      "sql": [
        "commands/order_set_label.sql"
      ],
      "ai": {
        "description": "Sets the opaque display label of an OPEN order (\"Mesa 4\", a customer name, a time). The label makes an open check recognizable in the open-checks list; sales does not interpret it (ADR-0144)."
      }
    },
    "sales.settings.update": {
      "permission": "sales.manage_settings",
      "transaction": true,
      "schema": "schemas/settings_update.json",
      "sql": [
        "commands/settings_upsert.sql"
      ],
      "ai": {
        "description": "Updates the point-of-sale configuration settings of the sales module"
      }
    },
    "sales.departments.create": {
      "permission": "sales.manage_settings",
      "schema": "schemas/department_create.json",
      "sql": [
        "commands/department_create.sql"
      ],
      "ai": {
        "description": "Adds a department to the till's open-price sheet: the name the cashier reads and the tax category it charges at."
      }
    },
    "sales.departments.update": {
      "permission": "sales.manage_settings",
      "schema": "schemas/department_update.json",
      "sql": [
        "commands/department_update.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "sales.department_not_found"
      },
      "ai": {
        "description": "Edits the name, the tax category or the position of one of the till's departments. It does not reprice anything already sold."
      }
    },
    "sales.departments.delete": {
      "permission": "sales.manage_settings",
      "schema": "schemas/department_delete.json",
      "sql": [
        "commands/department_delete.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "sales.department_not_found"
      },
      "ai": {
        "description": "Retires one of the till's departments. The lines already sold keep the name and the VAT they were charged with."
      }
    },
    "sales.quick_notes.create": {
      "permission": "sales.manage_settings",
      "schema": "schemas/quick_note_create.json",
      "sql": [
        "commands/quick_note_create.sql"
      ],
      "ai": {
        "description": "Adds a quick note to the till: the text becomes a chip on the line-note sheet, at the position given by sort_order."
      }
    },
    "sales.quick_notes.update": {
      "permission": "sales.manage_settings",
      "schema": "schemas/quick_note_update.json",
      "sql": [
        "commands/quick_note_update.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "sales.quick_note_not_found"
      },
      "ai": {
        "description": "Edits the text or the position of one of the till's quick notes."
      }
    },
    "sales.quick_notes.delete": {
      "permission": "sales.manage_settings",
      "schema": "schemas/quick_note_delete.json",
      "sql": [
        "commands/quick_note_delete.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "sales.quick_note_not_found"
      },
      "ai": {
        "description": "Retires one of the till's quick notes. The notes already typed on checks and sales keep their text."
      }
    },
    "sales._mark_order_line_paid": {
      "permission": "sales.add_sale",
      "sql": [
        "commands/_mark_order_line_paid.sql"
      ]
    },
    "sales._insert_refund": {
