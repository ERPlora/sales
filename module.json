{
  "id": "sales",
  "name": "Sales & POS",
  "version": "2.15.5",
  "description": "Point of sale: complete and void sales, and review sales history and metrics.",
  "agent": {
    "description": "Manages sales and point-of-sale operations: list and inspect sales, complete new sales transactions, void sales, configure payment methods, and retrieve sales statistics.",
    "keywords": [
      "sale",
      "pos",
      "payment",
      "transaction",
      "receipt",
      "void",
      "revenue",
      "checkout"
    ]
  },
  "depends_on": [
    "inventory",
    "taxes"
  ],
  "permissions": [
    "sales.view_sale",
    "sales.add_sale",
    "sales.change_sale",
    "sales.take_payment",
    "sales.sell_open_price",
    "sales.delete_sale",
    "sales.void_sale",
    "sales.view_paymentmethod",
    "sales.add_paymentmethod",
    "sales.change_paymentmethod",
    "sales.delete_paymentmethod",
    "sales.view_reports",
    "sales.manage_settings"
  ],
  "roles": [
    {
      "key": "cashier",
      "label": "Cashier",
      "extends": "employee"
    }
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "cashier": [
      "sales.view_sale",
      "sales.add_sale",
      "sales.change_sale",
      "sales.take_payment",
      "sales.view_paymentmethod"
    ],
    "manager": [
      "sales.view_sale",
      "sales.add_sale",
      "sales.change_sale",
      "sales.take_payment",
      "sales.void_sale",
      "sales.view_paymentmethod",
      "sales.add_paymentmethod",
      "sales.change_paymentmethod",
      "sales.view_reports",
      "sales.manage_settings",
      "sales.sell_open_price"
    ],
    "employee": [
      "sales.view_sale",
      "sales.add_sale",
      "sales.view_paymentmethod"
    ]
  },
  "navigation": [
    {
      "id": "pos",
      "label": "Vender",
      "icon": "storefront",
      "component": "erp-pos",
      "chrome": [
        "fullscreen"
      ]
    },
    {
      "id": "sales",
      "label": "Sales",
      "icon": "cart-outline",
      "component": "erp-sales-list"
    }
  ],
  "settings": {
    "title": "TPV",
    "icon": "card-outline",
    "schema": "schemas/settings_update.json",
    "get": "sales.settings.get",
    "set": "sales.settings.update"
  },
  "migrations": {
    "postgres": [
      "migrations/postgres/001_init.sql",
      "migrations/postgres/002_pos_settings.sql",
      "migrations/postgres/003_document_type.sql",
      "migrations/postgres/004_order_link.sql",
      "migrations/postgres/005_staff_attribution.sql",
      "migrations/postgres/006_tax_snapshot.sql",
      "migrations/postgres/007_gift_comp.sql",
      "migrations/postgres/008_receipt_marketing.sql",
      "migrations/postgres/009_cart_per_table.sql",
      "migrations/postgres/010_orders.sql",
      "migrations/postgres/011_sale_forgets_table.sql",
      "migrations/postgres/012_line_paid.sql",
      "migrations/postgres/013_drop_legacy_cart.sql",
      "migrations/postgres/014_quantity_fixed_point.sql",
      "migrations/postgres/015_order_label.sql",
      "migrations/postgres/016_order_rounds.sql",
      "migrations/postgres/017_idempotency_key.sql",
      "migrations/postgres/018_order_item_is_service.sql",
      "migrations/postgres/019_line_category_snapshot.sql",
      "migrations/postgres/020_void_audit.sql",
      "migrations/postgres/021_manual_discounts.sql"
    ]
  },
  "seed": {
    "postgres": [
      "seed/install.postgres.sql"
    ]
  },
  "queries": {
    "sales.list": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/list.sql",
      "list": {
        "search": [
          "sale_number",
          "payment_method_name",
          "customer_name"
        ],
        "sort": [
          "id",
          "sale_number",
          "status",
          "total",
          "tax_amount",
          "payment_method_name",
          "customer_name",
          "channel",
          "staff_id",
          "created_at"
        ],
        "default_sort": "created_at",
        "default_dir": "desc",
        "filters": {
          "sale_number": {
            "op": "eq"
          },
          "status": {
            "op": "eq"
          },
          "total": {
            "op": "range"
          },
          "tax_amount": {
            "op": "range"
          },
          "payment_method_name": {
            "op": "eq"
          },
          "customer_name": {
            "op": "like"
          },
          "channel": {
            "op": "eq"
          },
          "staff_id": {
            "op": "eq"
          },
          "created_at": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists sales records registered in the system"
      }
    },
    "sales.get": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/get.sql",
      "ai": {
        "description": "Retrieves the full detail of a sale by its identifier"
      }
    },
    "sales.lines": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/lines.sql",
      "ai": {
        "description": "Lists the product lines (items) belonging to a sale"
      }
    },
    "sales.orders.list": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/orders_list.sql",
      "ai": {
        "description": "Lists orders (ADR-0141). Serves both open tickets (status=open) and the cross-module read 'orders by customer/table' where satellite modules pass the order ids they own."
      }
    },
    "sales.order.get": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/order_get.sql",
      "ai": {
        "description": "Retrieves a single order (header) by its identifier (ADR-0141)"
      }
    },
    "sales.order.lines": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/order_lines.sql",
      "ai": {
        "description": "Lists the line items of an order (ADR-0141)"
      }
    },
    "sales.stats": {
      "permission": "sales.view_reports",
      "sql": "queries/stats.sql",
      "ai": {
        "description": "Returns aggregated sales statistics and metrics"
      }
    },
    "sales.payment_methods": {
      "permission": "sales.view_paymentmethod",
      "expose_api": true,
      "sql": "queries/payment_methods.sql",
      "ai": {
        "description": "Lists the available payment methods"
      }
    },
    "sales.settings.get": {
      "permission": "sales.manage_settings",
      "sql": "queries/settings_get.sql",
      "ai": {
        "description": "Retrieves the point-of-sale configuration settings (payment methods allowed, default sell screen, default document format)"
      }
    },
    "sales.today": {
      "permission": "sales.view_reports",
      "sql": "queries/today.sql",
      "ai": {
        "description": "Returns today's sales totals: amount sold and number of completed tickets"
      }
    },
    "sales.last_7_days": {
      "permission": "sales.view_reports",
      "sql": "queries/last_7_days.sql",
      "ai": {
        "description": "Returns the sales amount per day for the last 7 days (one row per day with sales)"
      }
    },
    "sales.by_idempotency_key": {
      "permission": "sales.view_sale",
      "sql": "queries/by_idempotency_key.sql",
      "ai": {
        "description": "Finds the sale recorded under a given idempotency key, if any. Used to make a retried checkout resolve to the very sale it already created instead of a second one."
      }
    },
    "sales.by_staff": {
      "permission": "sales.view_reports",
      "expose_api": true,
      "sql": "queries/by_staff.sql",
      "ai": {
        "description": "Breaks down completed sales attributed to each professional (staff_id) over a date range (date_from..date_to, inclusive): sales_count and gross/net/tax totals in cents. Backs the per-professional day close; combine with staff.commissions.summary to compute commission."
      }
    }
  },
  "commands": {
    "sales.complete_sale": {
      "permission": "sales.take_payment",
      "reads": [
        {
          "query": "taxes.rules.list",
          "required": true
        },
        "inventory.products.for_sale",
        "sales.payment_methods",
        "sales.settings.get",
        {
          "query": "sales.by_idempotency_key",
          "params": {
            "idempotency_key": "payload.idempotency_key"
          }
        }
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "complete_sale"
      },
      "schema": "schemas/complete_sale.json",
      "ai": {
        "description": "Completes and records a sale with its line items and payment. Optional staff_id attributes the sale to the professional who performed it; optional appointment_id traces a sale created from an appointment (emits sales.sale.created_from_appointment)."
      }
    },
    "sales.order.open": {
      "permission": "sales.add_sale",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "open_order"
      },
      "schema": "schemas/open_order.json",
      "ai": {
        "description": "Opens a new MUTABLE order (open ticket) with its line items materialized early (ADR-0141). The order is the canonical entity of the sale; on checkout it produces one or more immutable sales (split-bill). Amounts are provisional; the fiscal breakdown is frozen at checkout. Does not accept table_id (sales is table-agnostic; the table link is owned by the tables module)."
      }
    },
    "sales.order.fire": {
      "permission": "sales.add_sale",
      "reads": [
        {
          "query": "sales.order.lines",
          "params": {
            "order_id": "payload.order_id"
          }
        }
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "fire_order"
      },
      "schema": "schemas/fire_order.json",
      "ai": {
        "description": "Fires the current lines of an open order to production (kitchen/bar) — ADR-0141. The kitchen ticket is born from the ORDER, not from the payment: waiters fire when they take the order, long before any sale exists. `label` is an opaque display string (e.g. \"Table 4\", \"Bar\", \"Pickup Ana\") that sales forwards without interpreting, because sales knows nothing about tables or customers. Each call is a new round."
      }
    },
    "sales.void": {
      "permission": "sales.void_sale",
      "reads": [
        {
          "query": "sales.get",
          "params": {
            "sale_id": "payload.sale_id"
          },
          "required": true
        }
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "void_sale"
      },
      "schema": "schemas/void_sale.json",
      "ai": {
        "description": "Voids a COMPLETED sale with a mandatory reason (sales#26): the original stays immutable, voided_at/voided_by/void_reason are recorded, and sale.voided is emitted exactly once (a second call is refused with sales.already_voided). A sale that carries a full invoice cannot be voided: issue a credit note instead (sales.void_requires_credit_note)."
      }
    },
    "sales._void_sale": {
      "permission": "sales.void_sale",
      "sql": [
        "commands/_void_sale.sql"
      ],
      "ai": {
        "description": "Internal (sales#26): the state change of sales.void, resolved by the void_sale handler after it validated the sale against sales.get."
      }
    },
    "sales.create_payment_method": {
      "permission": "sales.add_paymentmethod",
      "transaction": true,
      "sql": [
        "commands/create_payment_method.sql"
      ],
      "ai": {
        "description": "Creates a new payment method available for sales"
      }
    },
    "sales._bump_counter": {
      "permission": "sales.add_sale",
      "sql": [
        "commands/_bump_counter.sql"
      ]
    },
    "sales._insert_sale": {
      "permission": "sales.add_sale",
      "sql": [
        "commands/_insert_sale.sql"
      ]
    },
    "sales._insert_line": {
      "permission": "sales.add_sale",
      "sql": [
        "commands/_insert_line.sql"
      ]
    },
    "sales._insert_order": {
      "permission": "sales.add_sale",
      "sql": [
        "commands/_insert_order.sql"
      ]
    },
    "sales._insert_order_line": {
      "permission": "sales.add_sale",
      "sql": [
        "commands/_insert_order_line.sql"
      ]
    },
    "sales._mark_lines_fired": {
      "permission": "sales.add_sale",
      "sql": [
        "commands/_mark_lines_fired.sql"
      ],
      "ai": {
        "description": "Internal (courses, 2026-07-19): marks the still-pending lines of an order as fired to the kitchen (round_no + fired_at). Emitted by sales.order.fire when the POS sends round_no; fired_at IS NULL guarantees the next fire only sends new lines."
      }
    },
    "sales._complete_order": {
      "permission": "sales.add_sale",
      "sql": [
        "commands/_complete_order.sql"
      ]
    },
    "sales.order.add_line": {
      "permission": "sales.add_sale",
      "transaction": true,
      "sql": [
        "commands/order_add_line.sql",
        "commands/order_recompute_total.sql"
      ],
      "ai": {
        "description": "Adds a line item to an open order and recomputes its provisional total (ADR-0141). Provisional amount; the fiscal breakdown is frozen at checkout."
      },
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "sales.order_unavailable",
        "message": "That order is not available: it does not exist in this business or it has been deleted."
      }
    },
    "sales.order.add_open_line": {
      "permission": "sales.sell_open_price",
      "transaction": true,
      "sql": [
        "commands/order_add_line.sql",
        "commands/order_recompute_total.sql"
      ],
      "ai": {
        "description": "Adds an OPEN-PRICE line (free amount, no catalogue product) to an open order and recomputes its provisional total. Same effect as sales.order.add_line but gated by sales.sell_open_price: nothing contradicts a typed amount, so the cashier needs the permission or a manager's PIN approval (ADR-0238)."
      },
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "sales.order_unavailable",
        "message": "That order is not available: it does not exist in this business or it has been deleted."
      }
    },
    "sales.order.update_line": {
      "permission": "sales.add_sale",
      "transaction": true,
      "sql": [
        "commands/order_update_line.sql",
        "commands/order_recompute_total.sql"
      ],
      "ai": {
        "description": "Updates the quantity of a line in an open order and recomputes its provisional total (ADR-0141)."
      }
    },
    "sales.order.remove_line": {
      "permission": "sales.add_sale",
      "transaction": true,
      "sql": [
        "commands/order_remove_line.sql",
        "commands/order_recompute_total.sql"
      ],
      "ai": {
        "description": "Removes (soft-deletes) a line from an open order and recomputes its provisional total (ADR-0141)."
      }
    },
    "sales.order.split": {
      "permission": "sales.add_sale",
      "transaction": true,
      "schema": "schemas/split_order.json",
      "sql": [
        "commands/order_split_create.sql",
        "commands/order_split_move_lines.sql",
        "commands/order_split_recompute_totals.sql"
      ],
      "ai": {
        "description": "Splits an open order in two (sales#61): the listed lines move to a NEW order, whose id comes back as new_ids[0]. Called when the floor opens a second check on a table (tables.sessions.split): tables owns the seating, sales owns the lines and the amounts. With no line_ids the second check opens blank. Nothing is prorated here — whole rows travel with their line_total, tax_category_key, round_no and fired_at intact, and BOTH totals are recomputed from their live lines, so the two halves add up to the original to the cent."
      }
    },
    "sales.order.merge": {
      "permission": "sales.add_sale",
      "transaction": true,
      "schema": "schemas/merge_orders.json",
      "sql": [
        "commands/order_merge_lines.sql",
        "commands/order_merge_void_source.sql",
        "commands/order_merge_recompute_totals.sql"
      ],
      "ai": {
        "description": "Joins two open orders into one (sales#61): every unpaid line of from_order_id moves to to_order_id and the source is voided. Called when two tables that BOTH ordered are merged (tables.sessions.merged) — tables cannot resolve that case because it does not know the lines. Lines are MOVED, not re-created, so what was already fired to the kitchen is not sent twice; both totals are recomputed from their live lines. Replaying it is a no-op."
      }
    },
    "sales.order.void": {
      "permission": "sales.void_sale",
      "transaction": true,
      "sql": [
        "commands/order_void.sql"
      ],
      "ai": {
        "description": "Voids an OPEN order (cancels the ticket before checkout); status open -> voided (ADR-0141)."
      }
    },
    "sales.order.set_discount": {
      "permission": "sales.add_sale",
      "transaction": true,
      "sql": [
        "commands/order_set_discount.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "sales.order_unavailable",
        "message": "That order is not open in this business."
      },
      "ai": {
        "description": "Sets the manual TICKET discount (percent, 0-100) of an OPEN order (sales#71). Applied by the server at checkout (sales.complete_sale discount_percent, prorated over the lines before the VAT); allow_discounts is enforced there."
      }
    },
    "sales.order.set_label": {
      "permission": "sales.add_sale",
      "transaction": true,
      "sql": [
        "commands/order_set_label.sql"
      ],
      "ai": {
        "description": "Sets the opaque display label of an OPEN order (\"Mesa 4\", a customer name, a time). The label makes an open check recognizable in the open-checks list; sales does not interpret it (ADR-0144)."
      }
    },
    "sales.settings.update": {
      "permission": "sales.manage_settings",
      "transaction": true,
      "schema": "schemas/settings_update.json",
      "sql": [
        "commands/settings_upsert.sql"
      ],
      "ai": {
        "description": "Updates the point-of-sale configuration settings of the sales module"
      }
    },
    "sales._mark_order_line_paid": {
      "permission": "sales.add_sale",
      "sql": [
        "commands/_mark_order_line_paid.sql"
      ],
      "ai": {
        "description": "Internal (ADR-0146): links an order line to the sale that charged it (split-bill). Emitted by complete_sale when it receives line_ids."
      }
    }
  },
  "events": {
    "listen": {},
    "emits": [
      "order.completed",
      "order.fired",
      "sale.completed",
      "sale.voided",
      "sales.order.opened",
      "sales.sale.created_from_appointment"
    ]
  },
  "widgets": {
    "sales.today": {
      "title": "Today's sales",
      "icon": "trending-up-outline",
      "category": "Ventas",
      "size": "sm",
      "permission": "sales.view_reports",
      "sectors": [
        "hosteleria",
        "retail",
        "belleza"
      ],
      "default": true,
      "kind": "kpi",
      "query": "sales.today",
      "refresh_on": [
        "sale.completed",
        "sale.voided"
      ],
      "map": {
        "value": "total"
      },
      "options": {
        "label": "Today",
        "icon": "cash-outline",
        "format": "currency",
        "currency": "EUR",
        "locale": "es-ES"
      }
    },
    "sales.tickets_today": {
      "title": "Today's tickets",
      "icon": "receipt-outline",
      "category": "Ventas",
      "size": "sm",
      "permission": "sales.view_reports",
      "sectors": [
        "hosteleria",
        "retail",
        "belleza"
      ],
      "default": true,
      "kind": "kpi",
      "query": "sales.today",
      "refresh_on": [
        "sale.completed",
        "sale.voided"
      ],
      "map": {
        "value": "tickets"
      },
      "options": {
        "label": "Tickets",
        "icon": "receipt-outline",
        "format": "number",
        "locale": "es-ES"
      }
    },
    "sales.last_7_days": {
      "title": "Sales, last 7 days",
      "icon": "bar-chart-outline",
      "category": "Ventas",
      "size": "lg",
      "permission": "sales.view_reports",
      "sectors": [
        "hosteleria",
        "retail",
        "belleza"
      ],
      "default": false,
      "kind": "chart",
      "query": "sales.last_7_days",
      "refresh_on": [
        "sale.completed",
        "sale.voided"
      ],
      "map": {
        "label": "day",
        "value": "total"
      },
      "options": {
        "chartType": "bar",
        "seriesName": "Ventas",
        "gridlines": true,
        "format": "currency",
        "height": 220
      }
    },
    "sales.recent_activity": {
      "title": "Recent activity",
      "icon": "time-outline",
      "category": "Ventas",
      "size": "md",
      "permission": "sales.view_sale",
      "sectors": [
        "hosteleria",
        "retail",
        "belleza"
      ],
      "default": false,
      "kind": "timeline",
      "query": "sales.list",
      "refresh_on": [
        "sale.completed",
        "sale.voided"
      ],
      "params": {
        "limit": 8,
        "sort": "created_at",
        "dir": "desc"
      },
      "map": {
        "id": "id",
        "title": "sale_number",
        "description": "customer_name",
        "time": "created_at",
        "status": "status"
      },
      "options": {
        "align": "left"
      }
    }
  },
  "ui": {
    "entry": "dist/sales.esm.js"
  }
}
