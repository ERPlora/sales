    "sales.add_sale",
    "sales.change_sale",
    "sales.take_payment",
    "sales.sell_open_price",
    "sales.delete_sale",
    "sales.void_sale",
    "sales.refund_sale",
    "sales.view_paymentmethod",
    "sales.add_paymentmethod",
    "sales.change_paymentmethod",
    "sales.delete_paymentmethod",
    "sales.view_reports",
    "sales.manage_settings"
  ],
  "roles": [
    {
      "key": "cashier",
      "label": "Cashier",
      "extends": "employee"
    }
  ],
  "role_permissions": {
