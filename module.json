{
  "id": "sales",
  "name": "Sales & POS",
  "version": "2.7.1",
  "agent": {
    "description": "Manages sales and point-of-sale operations: list and inspect sales, complete new sales transactions, void sales, configure payment methods, and retrieve sales statistics.",
    "keywords": [
      "sale",
      "pos",
      "payment",
      "transaction",
      "receipt",
      "void",
      "revenue",
      "checkout"
    ]
  },
  "depends_on": [
    "customers",
    "inventory",
    "taxes"
  ],
  "permissions": [
    "sales.view_sale",
    "sales.add_sale",
    "sales.change_sale",
    "sales.delete_sale",
    "sales.void_sale",
    "sales.view_paymentmethod",
    "sales.add_paymentmethod",
    "sales.change_paymentmethod",
    "sales.delete_paymentmethod",
    "sales.view_reports",
    "sales.manage_settings"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "sales.view_sale",
      "sales.add_sale",
      "sales.change_sale",
      "sales.void_sale",
      "sales.view_paymentmethod",
      "sales.add_paymentmethod",
      "sales.change_paymentmethod",
      "sales.view_reports",
      "sales.manage_settings"
    ],
    "employee": [
      "sales.view_sale",
      "sales.add_sale",
      "sales.view_paymentmethod"
    ]
  },
  "navigation": [
    {
      "id": "pos",
      "label": "Vender",
      "icon": "storefront",
      "component": "erp-pos",
      "chrome": [
        "fullscreen"
      ]
    },
    {
      "id": "sales",
      "label": "Sales",
      "icon": "cart-outline",
      "component": "erp-sales-list"
    }
  ],
  "settings": {
    "title": "TPV",
    "icon": "card-outline",
    "schema": "schemas/settings_update.json",
    "get": "sales.settings.get",
    "set": "sales.settings.update"
  },
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql",
      "migrations/sqlite/002_pos_settings.sql",
      "migrations/sqlite/003_document_type.sql",
      "migrations/sqlite/004_order_link.sql",
      "migrations/sqlite/005_staff_attribution.sql",
      "migrations/sqlite/006_tax_snapshot.sql",
      "migrations/sqlite/007_gift_comp.sql"
    ]
  },
  "queries": {
    "sales.list": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/list.sql",
      "list": {
        "search": [
          "sale_number",
          "payment_method_name",
          "customer_name"
        ],
        "sort": [
          "id",
          "sale_number",
          "status",
          "total",
          "tax_amount",
          "payment_method_name",
          "customer_name",
          "channel",
          "staff_id",
          "created_at"
        ],
        "default_sort": "created_at",
        "default_dir": "desc",
        "filters": {
          "sale_number": {
            "op": "eq"
          },
          "status": {
            "op": "eq"
          },
          "total": {
            "op": "range"
          },
          "tax_amount": {
            "op": "range"
          },
          "payment_method_name": {
            "op": "eq"
          },
          "customer_name": {
            "op": "eq"
          },
          "channel": {
            "op": "eq"
          },
          "staff_id": {
            "op": "eq"
          },
          "created_at": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists sales records registered in the system"
      }
    },
    "sales.get": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/get.sql",
      "ai": {
        "description": "Retrieves the full detail of a sale by its identifier"
      }
    },
    "sales.lines": {
      "permission": "sales.view_sale",
      "expose_api": true,
      "sql": "queries/lines.sql",
      "ai": {
        "description": "Lists the product lines (items) belonging to a sale"
      }
    },
    "sales.stats": {
      "permission": "sales.view_reports",
      "sql": "queries/stats.sql",
      "ai": {
        "description": "Returns aggregated sales statistics and metrics"
      }
    },
    "sales.payment_methods": {
      "permission": "sales.view_paymentmethod",
      "expose_api": true,
      "sql": "queries/payment_methods.sql",
      "ai": {
        "description": "Lists the available payment methods"
      }
    },
    "sales.settings.get": {
      "permission": "sales.manage_settings",
      "sql": "queries/settings_get.sql",
      "ai": {
        "description": "Retrieves the point-of-sale configuration settings (payment methods allowed, default sell screen, default document format)"
      }
    },
    "sales.cart.get": {
      "permission": "sales.view_sale",
      "sql": "queries/cart_get.sql",
      "ai": {
        "description": "Retrieves the active (in-progress) POS cart of the current employee, if any"
      }
    },
    "sales.parked_tickets": {
      "permission": "sales.view_sale",
      "sql": "queries/parked_tickets.sql",
      "ai": {
        "description": "Lists the parked (on-hold) POS tickets that have not expired yet, newest first"
      }
    },
    "sales.today": {
      "permission": "sales.view_reports",
      "sql": "queries/today.sql",
      "ai": {
        "description": "Returns today's sales totals: amount sold and number of completed tickets"
      }
    },
    "sales.last_7_days": {
      "permission": "sales.view_reports",
      "sql": "queries/last_7_days.sql",
      "ai": {
        "description": "Returns the sales amount per day for the last 7 days (one row per day with sales)"
      }
    },
    "sales.by_staff": {
      "permission": "sales.view_reports",
      "expose_api": true,
      "sql": "queries/by_staff.sql",
      "ai": {
        "description": "Breaks down completed sales attributed to each professional (staff_id) over a date range (date_from..date_to, inclusive): sales_count and gross/net/tax totals in cents. Backs the per-professional day close; combine with staff.commissions.summary to compute commission."
      }
    }
  },
  "commands": {
    "sales.complete_sale": {
      "permission": "sales.add_sale",
      "reads": [
        "taxes.rules.list"
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "complete_sale"
      },
      "schema": "schemas/complete_sale.json",
      "ai": {
        "description": "Completes and records a sale with its line items and payment. Optional staff_id attributes the sale to the professional who performed it; optional appointment_id traces a sale created from an appointment (emits sales.sale.created_from_appointment)."
      }
    },
    "sales.void": {
      "permission": "sales.void_sale",
      "transaction": true,
      "sql": [
        "commands/void.sql"
      ],
      "emit": [
        "sale.voided"
      ],
      "ai": {
        "description": "Voids an existing sale and emits the corresponding event (destructive)"
      }
    },
    "sales.create_payment_method": {
      "permission": "sales.add_paymentmethod",
      "transaction": true,
      "sql": [
        "commands/create_payment_method.sql"
      ],
      "ai": {
        "description": "Creates a new payment method available for sales"
      }
    },
    "sales._bump_counter": {
      "permission": "sales.add_sale",
      "sql": [
        "commands/_bump_counter.sql"
      ]
    },
    "sales._insert_sale": {
      "permission": "sales.add_sale",
      "sql": [
        "commands/_insert_sale.sql"
      ]
    },
    "sales._insert_line": {
      "permission": "sales.add_sale",
      "sql": [
        "commands/_insert_line.sql"
      ]
    },
    "sales.settings.update": {
      "permission": "sales.manage_settings",
      "transaction": true,
      "schema": "schemas/settings_update.json",
      "sql": [
        "commands/settings_upsert.sql"
      ],
      "ai": {
        "description": "Updates the point-of-sale configuration settings of the sales module"
      }
    },
    "sales.cart.save": {
      "permission": "sales.add_sale",
      "transaction": true,
      "sql": [
        "commands/cart_save.sql"
      ],
      "ai": {
        "description": "Saves (upserts) the active POS cart of the current employee so it survives reloads"
      }
    },
    "sales.cart.clear": {
      "permission": "sales.add_sale",
      "transaction": true,
      "sql": [
        "commands/cart_clear.sql"
      ],
      "ai": {
        "description": "Clears the active POS cart of the current employee"
      }
    },
    "sales.park_ticket": {
      "permission": "sales.add_sale",
      "transaction": true,
      "sql": [
        "commands/park_ticket.sql"
      ],
      "ai": {
        "description": "Parks (puts on hold) the current POS cart as a retrievable ticket with an expiry"
      }
    },
    "sales.retrieve_ticket": {
      "permission": "sales.add_sale",
      "transaction": true,
      "sql": [
        "commands/retrieve_ticket.sql"
      ],
      "ai": {
        "description": "Marks a parked POS ticket as retrieved so it disappears from the parked list"
      }
    },
    "sales.set_document_type": {
      "permission": "sales.add_sale",
      "transaction": true,
      "sql": [
        "commands/set_document_type.sql"
      ],
      "ai": {
        "description": "Sets the document type (ticket or invoice) issued for a sale"
      }
    }
  },
  "widgets": {
    "sales.today": {
      "title": "Ventas hoy",
      "icon": "trending-up-outline",
      "category": "Ventas",
      "size": "sm",
      "permission": "sales.view_reports",
      "sectors": [
        "hosteleria",
        "retail",
        "belleza"
      ],
      "default": true,
      "kind": "kpi",
      "query": "sales.today",
      "map": {
        "value": "total"
      },
      "options": {
        "label": "Hoy",
        "icon": "cash-outline",
        "format": "currency",
        "currency": "EUR",
        "locale": "es-ES"
      }
    },
    "sales.tickets_today": {
      "title": "Tickets hoy",
      "icon": "receipt-outline",
      "category": "Ventas",
      "size": "sm",
      "permission": "sales.view_reports",
      "sectors": [
        "hosteleria",
        "retail",
        "belleza"
      ],
      "default": true,
      "kind": "kpi",
      "query": "sales.today",
      "map": {
        "value": "tickets"
      },
      "options": {
        "label": "Tickets",
        "icon": "receipt-outline",
        "format": "number",
        "locale": "es-ES"
      }
    },
    "sales.last_7_days": {
      "title": "Ventas últimos 7 días",
      "icon": "bar-chart-outline",
      "category": "Ventas",
      "size": "lg",
      "permission": "sales.view_reports",
      "sectors": [
        "hosteleria",
        "retail",
        "belleza"
      ],
      "default": false,
      "kind": "chart",
      "query": "sales.last_7_days",
      "map": {
        "label": "day",
        "value": "total"
      },
      "options": {
        "chartType": "bar",
        "seriesName": "Ventas",
        "gridlines": true,
        "format": "currency",
        "height": 220
      }
    },
    "sales.recent_activity": {
      "title": "Actividad reciente",
      "icon": "time-outline",
      "category": "Ventas",
      "size": "md",
      "permission": "sales.view_sale",
      "sectors": [
        "hosteleria",
        "retail",
        "belleza"
      ],
      "default": false,
      "kind": "timeline",
      "query": "sales.list",
      "params": {
        "limit": 8,
        "sort": "created_at",
        "dir": "desc"
      },
      "map": {
        "id": "id",
        "title": "sale_number",
        "description": "customer_name",
        "time": "created_at",
        "status": "status"
      },
      "options": {
        "align": "left"
      }
    }
  },
  "ui": {
    "entry": "dist/sales.esm.js"
  }
}
